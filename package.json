{
  "name": "cucumber-cypress-exemplo",
  "version": "1.0.0",
  "description": "Automação E2E com Cypress, Cucumber, Gherkin e BDD",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:open": "cypress open",
    "test:smoke": "cypress run --env tags=@smoke",
    "test:regression": "cypress run --env tags=@regression"
  },
  "keywords": [
    "qa",
    "cypress",
    "cucumber",
    "gherkin",
    "bdd",
    "test-automation"
  ],
  "author": "Marcos Priotto",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^23.2.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.6",
    "cypress": "^14.5.4",
    "esbuild": "^0.25.10"
  },
  "cypress-cucumber-preprocessor": {
    "filterSpecs": true,
    "omitFiltered": true,
    "json": {
      "enabled": true,
      "output": "cucumber-report.json"
    },
    "html": {
      "enabled": true,
      "output": "cucumber-report.html"
    }
  }
}
